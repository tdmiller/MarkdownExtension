{
  "name": "@markdown-tooling/extension",
  "displayName": "Markdown Tooling",
  "description": "Starter VS Code extension scaffold for Markdown policy + WYSIWYG editing.",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onCommand:markdownTooling.openWysiwyg"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownTooling.openWysiwyg",
        "title": "Markdown Tooling: Open WYSIWYG Editor"
      }
    ]
  },
  "dependencies": {
    "@markdown-tooling/rendering": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
